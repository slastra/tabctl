([(1, 10, 'Inbox (3), Mail', 'https://mail.example/inbox', 0, true, true, 'https://mail.example/favicon.ico'), (1, 11, '日本語 ✓ café 🦊', 'https://unicode.example/%E8%B7%AF?q=1&x=2', 1, false, false, 'data:image/png;base64,iVBORw0KGgo='), (1, 12, '', 'about:blank', 2, false, false, ''), (2, 20, 'Second window', 'https://two.example/', 0, true, false, '')],)

